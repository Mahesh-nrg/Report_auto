# Copy to .env and adjust. docker compose reads .env automatically. For a plain `pwndoc-ai`
# run, export the variables first:  set -a; . ./.env; set +a
# Most of these can also be set in the in-app "AI Settings" (admins only), except
# PWNDOC_AI_DATA_DIR. A value supplied here wins over the saved settings and is not written to disk.

# Where the stock PwnDoc (nginx front end) is reachable from this gateway.
# Leave unset when using docker-compose (it defaults to https://host.docker.internal:8443).
# Inside a container "localhost" is the container itself, so do not use it there.
# PWNDOC_URL=https://localhost:8443

# Stock PwnDoc ships a self-signed certificate. A loopback upstream (localhost/127.0.0.1) is
# always accepted; for any other host (including host.docker.internal) set this to false to
# accept the self-signed certificate, or install a trusted certificate and keep it true.
PWNDOC_VERIFY_TLS=false

# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Ollama, LM Studio, vLLM, ...).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Where settings, RAG index, exports and finding backups are stored.
PWNDOC_AI_DATA_DIR=data

# CLI only (refine / upload / export): PwnDoc login. The password can also be typed at a prompt.
# PWNDOC_USERNAME=
# PWNDOC_PASSWORD=
